{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es2020"
    ],
    "baseUrl": "src",
    "paths": {
      "@src/*": ["./*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "types": [
      "vite/client",
      "vite-plugin-svgr/client",
      "node"
    ]
  },
  "include": [
    "*.ts",
    "vite.config.mts",
    "scripts/**/*.mts",
    "*.mjs",
    "./src",
    "tests/",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    ".eslintrc.cjs"
  ]
}
