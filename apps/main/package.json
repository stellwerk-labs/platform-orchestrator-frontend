{
  "name": "main-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@amplitude/analytics-browser": "^2.38.0",
    "@amplitude/plugin-session-replay-browser": "^1.27.5",
    "@ant-design/icons": "6.x",
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-react": "^3.0.29",
    "@datadog/browser-rum": "^6.32.0",
    "@openfeature/config-cat-web-provider": "^0.2.0",
    "@openfeature/react-sdk": "^1.2.1",
    "@tanstack/react-query": "^5.96.0",
    "@tanstack/react-query-devtools": "^5.96.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@xyflow/react": "^12.10.2",
    "antd": "^5.29.3",
    "axios": "^1.15.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "qs": "^6.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router": "^7.13.2",
    "react-syntax-highlighter": "^16.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "zustand": "^5.0.12"
  },
  "scripts": {
    "start": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "test": "NODE_OPTIONS=\"--max_old_space_size=8192\" TZ=UTC vitest --ui",
    "test:report": "vite preview --outDir vitest-report",
    "coverage": "vitest run --coverage",
    "test:ci": "TZ=UTC vitest run --silent",
    "e2e": "TEST_SUITE_TYPE=mock playwright test --browser=$npm_config_pwbrowser; exitcode=$? ; exit $exitcode",
    "e2e:ci": "TEST_SUITE_TYPE=mock playwright test --config=./playwright.config.ci.ts",
    "analyze": "source-map-explorer 'dist/assets/*.js'",
    "check-typescript": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1021.0",
    "@aws-sdk/lib-dynamodb": "^3.1021.0",
    "@axe-core/playwright": "^4.11.1",
    "@faker-js/faker": "^10.4.0",
    "@msw/playwright": "^0.6.6",
    "@playwright/test": "^1.58.2",
    "@svgr/webpack": "^8.1.0",
    "@types/dagre": "^0.7.54",
    "@types/gapi": "^0.0.47",
    "@types/gapi.auth2": "^0.0.61",
    "@types/js-yaml": "^4.0.9",
    "@types/json-pointer": "^1.0.34",
    "@types/json-schema": "^7.0.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@types/qs": "^6.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-styled-components": "^2.1.4",
    "execa": "^9.6.1",
    "lint-staged": "^16.4.0",
    "msw": "2.12.14",
    "mutationobserver-shim": "^0.3.7",
    "react-app-polyfill": "^3.0.0",
    "react-test-renderer": "^19.2.4",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vite-plugin-babel-macros": "^1.0.6",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-svgr": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
