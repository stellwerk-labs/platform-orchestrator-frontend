import { useMutation, useQueryClient } from '@tanstack/react-query';
import { AxiosError, AxiosResponse } from 'axios';

import { makeRequest } from '@src/utilities/make-request';

export const use{{pascalCase folderName}}{{pascalCase action}}Mutation = () => {
  const queryClient = useQueryClient();

  const { data, ...queryResult } = useMutation<
    AxiosResponse<ModelName>,
    AxiosError,
    {
      somePropForMutate: string;
    }
  >({
    mutationFn: ({ somePropForMutate }) => {
      return makeRequest('{{method}}', `$URL`, { somePropForMutate });
    },
    onSuccess: () => {
      queryClient.invalidateQueries({
        queryKey: `someQueryKey`,
      });
    },
  });

  return { ...queryResult, data: data?.data };
};
